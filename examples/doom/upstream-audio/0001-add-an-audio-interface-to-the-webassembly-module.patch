   for (int i = 0; i < UINT8_MAX; i++) {
     // If the actual state of this key doesn't match the last communicated state
@@ -359,3 +366,229 @@ void DG_PCXScreenshotTaken(unsigned char *screenshotBytes,
   // currently allow in this implementation (in fact, we don't allow the passing
   // of ANY command line arguments to Doom).
 }
+
+// *****************************************************************************
+// *                                    (3)                                    *
+// *                                                                           *
+// *      Implement Doom's low-level sound and music modules by forwarding     *
+// *                  to the functions imported via WebAssembly                *
+// *                                                                           *
+// *****************************************************************************
+
+/*
+ * Doom's sound layers are: `s_sound.c` decides what should be heard,
+ * `i_sound.c` picks a module, and the module actually makes noise. Only the
+ * last of those is host-specific, so it is the only one implemented here: the
+ * two module structs below fill the `DG_sound_module` / `DG_music_module`
+ * hooks that `i_sound.c` looks for, and every function that would touch an
+ * audio device instead calls the matching `audio` import.
+ *
+ * Sample data crosses the boundary once per sound, not once per play:
+ * `RegisterSfx` hands over a sound's lump the first time it is heard, and
+ * every later `startSound` names it by the id alone. So the host never needs
+ * to know how a WAD is laid out.
+ */
+
+// The channel handles Doom hands back to `S_StartSound` are the channel
+// numbers themselves, so `I_StopSound(handle)` and `channels[i].handle` agree
+// without a mapping table on this side.
+#define WASM_SOUND_MAX_CHANNELS 16
+
+// Whether each sound in `S_sfx` has been handed to `registerSound` yet.
+static boolean sfxRegistered[NUMSFX] = {false};
+
+static boolean RegisterSfx(sfxinfo_t *sfxinfo, int sfxId) {
+  if (sfxId < 0 || sfxId >= NUMSFX) {
+    return false;
+  }
+  if (sfxRegistered[sfxId]) {
+    return true;
+  }
+  if (sfxinfo->lumpnum < 0) {
+    return false;
+  }
+
+  const uint8_t *data = W_CacheLumpNum(sfxinfo->lumpnum, PU_STATIC);
+  registerSound(sfxId, data, W_LumpLength(sfxinfo->lumpnum));
+  sfxRegistered[sfxId] = true;
+  return true;
+}
+
+static boolean I_WASM_InitSound(boolean _use_sfx_prefix) {
+  (void)_use_sfx_prefix;
+  memset(sfxRegistered, 0, sizeof(sfxRegistered));
+  return true;
+}
+
+static void I_WASM_ShutdownSound(void) {
+  for (int channel = 0; channel < WASM_SOUND_MAX_CHANNELS; ++channel) {
+    stopSound(channel);
+  }
+}
+
+// Doom prefixes sound lump names with "DS"; `sfxinfo->link`, when set, names
+// the sound whose data should be heard in this one's place.
+static int I_WASM_GetSfxLumpNum(sfxinfo_t *sfxinfo) {
+  char namebuf[9];
+  sfxinfo_t *sfx = sfxinfo->link != NULL ? sfxinfo->link : sfxinfo;
+
+  M_snprintf(namebuf, sizeof(namebuf), "ds%s", DEH_String(sfx->name));
+
+  return W_GetNumForName(namebuf);
+}
+
+// The host owns its own mixing, so there is nothing to pump from here.
+static void I_WASM_UpdateSound(void) {}
+
+static void I_WASM_UpdateSoundParams(int channel, int volume, int separation) {
+  updateSoundParams(channel, volume, separation);
+}
+
+static int I_WASM_StartSound(sfxinfo_t *sfxinfo, int channel, int volume,
+                             int separation) {
+  int sfxId = (int)(sfxinfo - S_sfx);
+
+  if (!RegisterSfx(sfxinfo, sfxId)) {
+    return -1;
+  }
+
+  startSound(sfxId, channel, volume, separation);
+  return channel;
+}
+
+static void I_WASM_StopSound(int channel) { stopSound(channel); }
+
+static boolean I_WASM_SoundIsPlaying(int channel) {
+  return soundIsPlaying(channel) != 0;
+}
+
+// Nothing to do: `I_WASM_StartSound` registers a sound the first time it is
+// heard, so there is no second path to keep in step here.
+//
+// Precaching would also have to resolve every lump itself rather than trust
+// `sfxinfo->lumpnum`. `S_Init` calls this before the loop that sets each
+// `lumpnum` to -1, so at this point they are all still zero -- which is a
+// real lump (`PLAYPAL`), not an obviously invalid one.
+static void I_WASM_PrecacheSounds(sfxinfo_t *sounds, int num_sounds) {
+  (void)sounds;
+  (void)num_sounds;
+}
+
+static boolean I_WASM_InitMusic(void) { return true; }
+
+static void I_WASM_ShutdownMusic(void) { stopSong(); }
+
+static void I_WASM_SetMusicVolume(int volume) { setMusicVolume(volume); }
+
+static void I_WASM_PauseSong(void) { pauseSong(); }
+
+static void I_WASM_ResumeSong(void) { resumeSong(); }
+
+// Doom's music lumps are MUS, its own compact MIDI encoding, which nothing
+// outside Doom plays. Converting here rather than at the import boundary
+// means a host needs only a MIDI player, and matches what the SDL module
+// does before handing a lump to SDL_mixer.
+#define MUS_HEADER_MAGIC "MUS\x1a"
+// The largest MIDI a MUS lump is expected to produce; the SDL module uses
+// the same bound.
+#define MAX_MIDI_LENGTH (96 * 1024)
+
+static boolean IsMus(const byte *data, int len) {
+  return len > 3 && memcmp(data, MUS_HEADER_MAGIC, 4) == 0;
+}
+
+// Doom treats the handle as an opaque pointer and only checks it against
+// NULL, so the host's non-zero handle travels as one. A host that declines
+// the music answers 0, which becomes NULL and leaves Doom silent.
+static void *I_WASM_RegisterSong(void *data, int len) {
+  int32_t handle = 0;
+
+  if (IsMus((const byte *)data, len)) {
+    MEMFILE *musinput = mem_fopen_read(data, len);
+    MEMFILE *midioutput = mem_fopen_write();
+
+    if (musinput != NULL && midioutput != NULL &&
+        !mus2mid(musinput, midioutput)) {
+      void *midi;
+      size_t midilen;
+
+      mem_get_buf(midioutput, &midi, &midilen);
+      if (midilen <= MAX_MIDI_LENGTH) {
+        handle = registerSong((const uint8_t *)midi, midilen);
+      }
+    }
+
+    if (musinput != NULL) {
+      mem_fclose(musinput);
+    }
+    if (midioutput != NULL) {
+      mem_fclose(midioutput);
+    }
+  } else {
+    // Already a MIDI (a PWAD may substitute one), so pass it straight on.
+    handle = registerSong((const uint8_t *)data, (size_t)len);
+  }
+
+  return handle == 0 ? NULL : (void *)(intptr_t)handle;
+}
+
+static void I_WASM_UnRegisterSong(void *handle) {
+  if (handle != NULL) {
+    unregisterSong((int32_t)(intptr_t)handle);
+  }
+}
+
+static void I_WASM_PlaySong(void *handle, boolean looping) {
+  if (handle != NULL) {
+    playSong((int32_t)(intptr_t)handle, looping ? 1 : 0);
+  }
+}
+
+static void I_WASM_StopSong(void) { stopSong(); }
+
+static boolean I_WASM_MusicIsPlaying(void) { return songIsPlaying() != 0; }
+
+static void I_WASM_PollMusic(void) {}
+
+// `i_sound.c` matches a module against the configured device before using it.
+// These are the device lists the SDL modules claim, which is every device a
+// host that mixes for itself can stand in for.
