+/*
+ * Register the sample data for one sound effect
+ *
+ * Called at most once per `sfxId`, before the first `startSound` naming it.
+ * The data is a DMX sound lump: an 8-byte header (a 16-bit format field that
+ * is always 3, a 16-bit sample rate, and a 32-bit sample count) followed by
+ * unsigned 8-bit mono samples, of which DMX ignores the first and last 16.
+ *
+ * args:
+ *  sfxId:
+ *    - identifies this sound effect for the whole run
+ *  data:
+ *    - location in memory of the sound lump
+ *  length:
+ *    - length, in bytes, of the sound lump
+ */
+IMPORT_MODULE("audio")
+void registerSound(int32_t sfxId, const uint8_t *data, size_t length);
+
+/*
+ * Start a sound effect on a channel, replacing whatever plays there
+ *
+ * args:
+ *  sfxId:
+ *    - a sound effect previously handed to `registerSound`
+ *  channel:
+ *    - the channel to play on, in the range [0, 16)
+ *  volume:
+ *    - range [0, 127]
+ *  separation:
+ *    - stereo position, range [0, 254]; 128 is centred
+ */
+IMPORT_MODULE("audio")
+void startSound(int32_t sfxId, int32_t channel, int32_t volume,
+                int32_t separation);
+
+/*
+ * Stop whatever is playing on a channel
+ */
+IMPORT_MODULE("audio") void stopSound(int32_t channel);
+
+/*
+ * Change the volume and stereo position of a playing channel
+ *
+ * Called as the listener or the sound's origin moves, on a channel that
+ * `startSound` was previously called for.
+ */
+IMPORT_MODULE("audio")
+void updateSoundParams(int32_t channel, int32_t volume, int32_t separation);
+
+/*
+ * Report whether a channel still has sound playing on it
+ *
+ * returns:
+ *  non-zero if the channel is still playing, 0 otherwise
+ */
+IMPORT_MODULE("audio") int32_t soundIsPlaying(int32_t channel);
+
+/*
+ * Register a piece of music, returning a handle for it
+ *
+ * The data is a standard MIDI file. Doom's own music lumps are in its
+ * compact MUS encoding, which this module converts before calling this
+ * function, so that a host needs only a MIDI player.
+ *
+ * args:
+ *  data:
+ *    - location in memory of the music lump
+ *  length:
+ *    - length, in bytes, of the music lump
+ *
+ * returns:
+ *  A non-zero handle naming this music for `playSong` and `unregisterSong`,
+ *  or 0 if the music could not be registered, in which case Doom plays no
+ *  music rather than reporting an error.
+ */
+IMPORT_MODULE("audio")
+int32_t registerSong(const uint8_t *data, size_t length);
+
+/*
+ * Release a handle previously returned by `registerSong`
+ */
+IMPORT_MODULE("audio") void unregisterSong(int32_t handle);
+
+/*
+ * Start playing a piece of music, replacing whatever is playing
+ *
+ * args:
+ *  handle:
+ *    - a handle previously returned by `registerSong`
+ *  looping:
+ *    - non-zero to repeat the music until stopped
+ */
+IMPORT_MODULE("audio") void playSong(int32_t handle, int32_t looping);
+
+/*
+ * Stop the music that is playing, if any
+ */
+IMPORT_MODULE("audio") void stopSong();
+
+/*
+ * Pause the music that is playing, if any
+ */
+IMPORT_MODULE("audio") void pauseSong();
+
+/*
+ * Resume music paused by `pauseSong`
+ */
+IMPORT_MODULE("audio") void resumeSong();
+
+/*
+ * Set the music volume
