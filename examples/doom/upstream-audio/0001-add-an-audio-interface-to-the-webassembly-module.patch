diff --git a/src/doom_wasm.c b/src/doom_wasm.c
index 200c541..ea8f366 100644
--- a/src/doom_wasm.c
+++ b/src/doom_wasm.c
@@ -1,10 +1,17 @@
-#include <stdbool.h>
 #include <stdio.h>
